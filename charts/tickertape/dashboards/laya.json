          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(created_at, '1h'), answer AS metric, count(*) AS answers FROM decisions WHERE $__timeFilter(created_at) AND question = '$question' GROUP BY 1, 2 ORDER BY 1"
