          "rawSql": "SELECT i.laya_done_at AS answered, i.source, i.focus_ticker AS ticker, i.title, i.link, round(d.confidence::numeric, 2) AS confidence FROM decisions d JOIN items i ON i.id = d.item_id WHERE d.question = 'action' AND d.answer = 'alert' AND $__timeFilter(d.created_at) ORDER BY i.laya_done_at DESC LIMIT 50"
        }
      ],
