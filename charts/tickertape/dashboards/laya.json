          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT model_rev, question, answer, count(*) AS answers, round(avg(confidence)::numeric, 2) AS avg_confidence FROM decisions WHERE $__timeFilter(created_at) GROUP BY 1, 2, 3 ORDER BY 1, 2, 4 DESC"
