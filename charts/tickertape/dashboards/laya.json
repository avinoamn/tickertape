            "uid": "tickertape-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT to_char(floor(least(confidence, 0.9999) * 10) / 10, 'FM0.0') AS bucket, count(*) AS answers FROM decisions WHERE $__timeFilter(created_at) AND question = '$question' GROUP BY 1 ORDER BY 1"
