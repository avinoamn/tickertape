    {
      "id": 13,
      "type": "barchart",
      "title": "Confidence histogram: $question",
      "description": "Calibrated confidence, bucketed by 0.1. This is the value the pipeline gates on.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tickertape-pg"
      },
      "targets": [
        {
          "refId": "A",
