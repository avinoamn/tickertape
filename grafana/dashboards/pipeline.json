    {
      "id": 6,
      "type": "table",
      "title": "Backlog per stage",
      "description": "Rows waiting for each stage and how long the oldest has waited.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tickertape-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tickertape-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT 'ner (status new)' AS stage, count(*) AS waiting, coalesce(extract(epoch FROM now() - min(created_at)), 0)::int AS oldest_waiting FROM items WHERE status = 'new' UNION ALL SELECT 'laya (status ner_done)', count(*), coalesce(extract(epoch FROM now() - min(ner_done_at)), 0)::int FROM items WHERE status = 'ner_done'"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 10,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "oldest_waiting"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "waiting"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "value": null,
                      "color": "green"
                    },
                    {
                      "value": 50,
                      "color": "#EAB839"
                    },
                    {
                      "value": 200,
                      "color": "red"
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Throughput per hour: ingested, ner done, laya done",
      "description": "Where arrivals outrun completions, the backlog grows.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tickertape-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tickertape-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(created_at, '1h'), 'ingested' AS metric, count(*) AS n FROM items WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tickertape-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(ner_done_at, '1h'), 'ner done' AS metric, count(*) AS n FROM items WHERE $__timeFilter(ner_done_at) GROUP BY 1 ORDER BY 1"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tickertape-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(laya_done_at, '1h'), 'laya done' AS metric, count(*) AS n FROM items WHERE $__timeFilter(laya_done_at) GROUP BY 1 ORDER BY 1"
        }
      ],
      "gridPos": {
        "x": 10,
        "y": 4,
        "w": 14,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "End-to-end latency (laya_done_at - created_at), p50 / p95",
      "description": "Includes queueing time, so a backlog shows up here as a big number.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tickertape-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tickertape-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(laya_done_at, '1h'), percentile_cont(0.5) WITHIN GROUP (ORDER BY extract(epoch FROM laya_done_at - created_at)) AS p50, percentile_cont(0.95) WITHIN GROUP (ORDER BY extract(epoch FROM laya_done_at - created_at)) AS p95 FROM items WHERE laya_done_at IS NOT NULL AND $__timeFilter(laya_done_at) GROUP BY 1 ORDER BY 1"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 14,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
