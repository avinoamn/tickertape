    {
      "id": 13,
      "type": "table",
      "title": "Focus ticker rate by source (range)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tickertape-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tickertape-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT source, count(*) AS items, round(100.0 * avg((focus_ticker IS NOT NULL)::int), 1) AS focus_ticker_pct FROM items WHERE ner_done_at IS NOT NULL AND $__timeFilter(ner_done_at) GROUP BY 1 ORDER BY 1"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
