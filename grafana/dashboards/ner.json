    {
      "id": 12,
      "type": "timeseries",
      "title": "Items with a focus ticker (% per hour)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tickertape-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tickertape-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(ner_done_at, '1h'), 100.0 * avg((focus_ticker IS NOT NULL)::int) AS focus_ticker_pct FROM items WHERE ner_done_at IS NOT NULL AND $__timeFilter(ner_done_at) GROUP BY 1 ORDER BY 1"
