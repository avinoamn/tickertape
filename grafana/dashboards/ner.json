    {
      "id": 8,
      "type": "timeseries",
      "title": "Inference latency per call (p50 / p95)",
      "description": "One model call covers a whole batch (up to 16 items). Per-item time is in the next panel.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(ner_inference_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50",
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ner_inference_seconds_bucket[$__rate_interval])))",
