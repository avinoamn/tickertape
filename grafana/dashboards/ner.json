    {
      "id": 4,
      "type": "stat",
      "title": "With focus ticker (range)",
      "description": "Share of NER-processed items where a focus ticker was resolved.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tickertape-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tickertape-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT 100.0 * avg((focus_ticker IS NOT NULL)::int) AS pct FROM items WHERE ner_done_at IS NOT NULL AND $__timeFilter(ner_done_at)"
        }
      ],
      "gridPos": {
